@* @Model *@

<h1>get all students view</h1>


<table class="table table-bordered table-hover">
    <tr>
        <th>Id</th>
        <th>Name</th>
        <th>Age</th>
        <th>DeptId</th>
        <th>Image</th>
    </tr>

    @foreach (Student student in @Model)
    {
        <tr>
            <td>@student.Id</td>
            <td>@student.Name</td>
            <td>@student.Age</td>
            <td>@student.DeptId</td>
            <td><img src="~/assets/@student.ImageUrl" style="width:75px" /></td>
        </tr>
    }


</table>

