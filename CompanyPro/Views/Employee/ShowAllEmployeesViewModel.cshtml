@* @model List<CompanyPro.ViewModels.GetAllEmployeesViewModel> *@
@* @using CompanyPro.ViewModels
@model List<GetAllEmployeesViewModel> *@

@model List<GetAllEmployeesViewModel>

<h1>get all Employees view model</h1>


@* <p>@(Model[0].Message-10)</p> *@
<p>@(Model[0].Temp + 10)</p>

@* @{
    List<string>? branches = ViewData["branches"] as List<string> ?? new();
} *@

<select class="form-control">
    @foreach (var item in Model[0].Branches)
    {
        <option>@item</option>
    }
</select>

<br />


<table class="table table-bordered table-hover">
    <tr>
        <th>Id</th>
        <th>Name</th>
        <th>Salary</th>
        <th>DepartmentId</th>
        <th>Address</th>
    </tr>

    @foreach (var employee in @Model)
    {
        <tr>
            <td style="color:@employee?.Color">@employee?.Eid</td>
            <td style="color:@employee?.Color">@employee?.EmpName</td>
            <td style="color:@employee?.Color">@employee?.Salary</td>
            <td style="color:@employee?.Color">@employee?.DeptName</td>
            <td style="color:@employee?.Color">@employee?.Address</td>
        </tr>
    }
</table>

